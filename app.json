{
  "expo": {
    "name": "Nomrank",
    "slug": "nomrank",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomrank",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.nomrank.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#17111c",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "beta.nomrank.in",
              "pathPrefix": "/review"
            },
            {
              "scheme": "https",
              "host": "beta.nomrank.in",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "beta.nomrank.in",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "beta.nomrank.in",
              "pathPrefix": "/top/"
            },
            {
              "scheme": "https",
              "host": "www.nomrank.in",
              "pathPrefix": "/review"
            },
            {
              "scheme": "https",
              "host": "www.nomrank.in",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "www.nomrank.in",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "www.nomrank.in",
              "pathPrefix": "/top/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17111c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nomrank uses your photos so you can add them to your takes and profile.",
          "cameraPermission": "Nomrank uses your camera so you can snap what you're eating."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff4b3a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(...); }\n-keep class androidx.work.** { *; }\n"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
