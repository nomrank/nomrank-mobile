{
  "expo": {
    "name": "Nomrank",
    "slug": "nomrank",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomrank",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.nomrank.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#17111c",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17111c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nomrank uses your photos so you can add them to your takes and profile.",
          "cameraPermission": "Nomrank uses your camera so you can snap what you're eating."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff4b3a"
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(...); }\n-keep class androidx.work.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
